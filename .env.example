# Copy to .env and fill in. Never commit .env.

# --- LLM providers (plan §4.7). Bedrock is primary, OpenAI the fallback.
LLM_PROVIDER_ORDER=bedrock,openai
AWS_BEDROCK_REGION=ap-southeast-1
AWS_BEDROCK_API_KEY=
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0   # passed Day-1 probe; Claude needs Anthropic use-case form
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# --- Data
DATA_MODE=live            # live | snapshot (offline data retrieval from data/snapshots)
DATAGOV_API_KEY=          # optional; raises data.gov.sg rate limits

# --- Runtime (docker-compose sets DATABASE_URL/REDIS_URL for containers)
APP_ENV=dev
LOG_LEVEL=INFO
# DATABASE_URL=postgresql+asyncpg://policy:policy@localhost:5432/policy
# REDIS_URL=redis://localhost:6379/0
ENABLE_FAULT_INJECTION=false   # dev/demo only; rejected when APP_ENV=prod

# --- Host ports (change if something else already listens on them)
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
